# Helper Functions ------------------------------------------
# Usage:
#
#   run     <command>    -> Start only if not already running (daemons).
#   run_bg  <command>    -> Always execute (one-shot commands/scripts).
#   restart <command>    -> Gracefully restart a running daemon.

# Check whether a process is already running.
is_running() {
	pgrep -x "${1##*/}" >/dev/null 2>&1
}

# Start a daemon only if it is not already running.
run() {
	if ! is_running "$1"; then
		"$@" >/dev/null 2>&1 &
	fi
}

# Run a command unconditionally.
run_bg() {
	"$@" >/dev/null 2>&1 &
}

# Restart a running process gracefully.
restart() {
	local proc="${1##*/}"

	if is_running "$proc"; then
		pkill -TERM -x "$proc"

		while is_running "$proc"; do
			sleep 0.1
		done
	fi

	"$@" >/dev/null 2>&1 &
}

# Appearance ------------------------------------------------

# Restore wallpaper
nitrogen --restore

# Launch Polybar or Tint2
run_bg ~/.config/openbox/themes/launch-bar.sh

# Compositor
run_bg ~/.config/openbox/scripts/ob-picom

# Dock
run plank

# Desktop Services ------------------------------------------

# XFCE settings daemon (themes, fonts, icons, cursor, DPI...)
run xfsettingsd

# Power manager
run xfce4-power-manager

# PolicyKit authentication agent
run /usr/lib/xfce-polkit/xfce-polkit

# Notification daemon
restart dunst

# Music Player Daemon
run mpd

# Thunar daemon
run thunar --daemon

# Hot Corners -----------------------------------------------

# Creates sensors for each configured corner
run lead

# Start skippy-xd (X11 window selector) as daemon
run skippy-xd --start-daemon

# Keyboard --------------------------------------------------

# Enable Super key to open the application menu
run ksuperkey -e 'Super_L=Alt_L|F1'
run ksuperkey -e 'Super_R=Alt_L|F1'

# Optional Applets ------------------------------------------

